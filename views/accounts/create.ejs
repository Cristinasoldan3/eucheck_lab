
<!DOCTYPE html>
<html lang="ro">
<head>
  <meta charset="UTF-8">
  <title>Adăugare Cont B2B</title>
  <style>
    body { font-family: Segoe UI, Arial, sans-serif; margin: 30px; background: #f8f9fa; }
    .box { background: white; padding: 25px; border-radius: 6px; border: 1px solid #ced4da; max-width: 480px; }
    .group { margin-bottom: 12px; }
    label { display: block; font-weight: 600; margin-bottom: 4px; }
    input[type="text"], input[type="email"], input[type="number"], select { width: 100%; padding: 8px; box-sizing: border-box; border: 1px solid #ced4da; border-radius: 4px; }
    .btn { background: #28a745; color: white; padding: 9px 18px; border: none; border-radius: 4px; cursor: pointer; font-weight: bold; }
    a { color: #007bff; text-decoration: none; }
  </style>
</head>
<body>
  <h2>Adăugare Utilizator / Solicitare B2B</h2>
  <div class="box">
    <form action="/Accounts/Create" method="POST">
      <!-- Casete text -->
      <div class="group">
        <label for="email">Adresă Email:</label>
        <input type="email" id="email" name="email" required />
      </div>

      <div class="group">
        <label for="full_name">Nume Reprezentant:</label>
        <input type="text" id="full_name" name="full_name" />
      </div>

      <div class="group">
        <label for="company_name">Nume Companie (pentru B2B):</label>
        <input type="text" id="company_name" name="company_name" />
      </div>

      <div class="group">
        <label for="vat_number">Cod Fiscal (CUI):</label>
        <input type="text" id="vat_number" name="vat_number" />
      </div>

      <!-- Listă de selecție (Dropdown) -->
      <div class="group">
        <label for="tier">Pachet Comercial:</label>
        <select id="tier" name="tier">
          <% tiers.forEach(function(t) { %>
            <option value="<%= t.id %>"><%= t.name %></option>
          <% }); %>
        </select>
      </div>

      <div class="group">
        <label for="tokens_balance">Tokeni Alocați Inițial:</label>
        <input type="number" id="tokens_balance" name="tokens_balance" value="5" min="0" />
      </div>

      <!-- Control Checkbox -->
      <div class="group">
        <label style="font-weight: normal;">
          <input type="checkbox" name="can_export_pdf" checked />
          Aprobă dreptul de export rapoarte oficiale PDF
        </label>
      </div>

      <div class="group">
        <label style="font-weight: normal;">
          <input type="checkbox" name="has_unlimited_scans" />
          Activează regimul de scanări nelimitate
        </label>
      </div>

      <button type="submit" class="btn">Salvează Contul</button>
    </form>
    <br />
    <a href="/Accounts">Înapoi la Listă</a>
  </div>
</body>
</html>