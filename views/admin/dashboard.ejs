<!DOCTYPE html>
<html lang="ro">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>EUCheck Admin - Control Center</title>
    <!-- Tailwind CSS & FontAwesome -->
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        @keyframes pulseGlow {
            0%, 100% { opacity: 0.4; transform: scale(1); }
            50% { opacity: 0.8; transform: scale(1.05); }
        }
        .glow-effect {
            animation: pulseGlow 4s infinite ease-in-out;
        }
    </style>
</head>
<body class="bg-[#090d16] text-slate-100 min-h-screen font-sans selection:bg-indigo-500 selection:text-white relative overflow-x-hidden">

    <!-- Elemente decorative de fundal tip "tsunami/glow" -->
    <div class="absolute top-0 left-1/4 w-96 h-96 bg-indigo-600/10 rounded-full blur-[120px] pointer-events-none glow-effect"></div>
    <div class="absolute top-40 right-1/4 w-96 h-96 bg-purple-600/10 rounded-full blur-[120px] pointer-events-none glow-effect" style="animation-delay: 2s;"></div>

    <!-- NAVBAR SUPERIOR -->
    <header class="bg-[#0f172a]/70 backdrop-blur-xl border-b border-slate-800/80 sticky top-0 z-50 px-8 py-4 flex justify-between items-center transition-all duration-300">
        <div class="flex items-center space-x-3 group cursor-pointer">
            <div class="bg-gradient-to-tr from-indigo-600 to-violet-500 text-white p-2.5 rounded-2xl shadow-lg shadow-indigo-500/20 group-hover:scale-110 transition-transform duration-300">
                <i class="fa-solid fa-shield-halved text-lg"></i>
            </div>
            <div>
                <span class="text-lg font-black tracking-wider text-white">EUCHECK </span>
                <span class="block text-[10px] text-slate-400 font-semibold tracking-widest uppercase">Admin Security</span>
            </div>
        </div>

        <nav class="hidden lg:flex space-x-1 bg-slate-900/80 p-1.5 rounded-2xl border border-slate-800/80 backdrop-blur-md">
            <a href="/Admin" class="px-4 py-2 rounded-xl text-xs font-bold bg-indigo-600 text-white shadow-lg shadow-indigo-600/30 transition-all">Dashboard</a>
            <a href="/Accounts" class="px-4 py-2 rounded-xl text-xs font-medium text-slate-400 hover:text-white hover:bg-slate-800/50 transition-all">Conturi</a>
            <a href="/Standards" class="px-4 py-2 rounded-xl text-xs font-medium text-slate-400 hover:text-white hover:bg-slate-800/50 transition-all">Directive UE</a>
            <a href="/ComplianceRules" class="px-4 py-2 rounded-xl text-xs font-medium text-slate-400 hover:text-white hover:bg-slate-800/50 transition-all">Reguli</a>
            <a href="/Admin/Plans" class="px-4 py-2 rounded-xl text-xs font-medium text-slate-400 hover:text-white hover:bg-slate-800/50 transition-all">Pachete</a>
            <a href="/Admin/Logs" class="px-4 py-2 rounded-xl text-xs font-medium text-slate-400 hover:text-white hover:bg-slate-800/50 transition-all">Jurnal</a>
        </nav>

        <div class="flex items-center space-x-3 bg-slate-900/80 border border-slate-800/80 px-4 py-2 rounded-2xl shadow-inner">
            <div class="relative flex items-center justify-center">
                <div class="w-2.5 h-2.5 rounded-full bg-emerald-500"></div>
                <div class="absolute w-4 h-4 rounded-full bg-emerald-500/40 animate-ping"></div>
            </div>
            <span class="text-xs font-bold text-slate-300 tracking-wide">admin.eucheck@gmail.com</span>
        </div>
    </header>

    <!-- CONTINUT PRINCIPAL -->
    <main class="max-w-7xl mx-auto px-6 py-10 relative z-10">
        
        <!-- BANNER HERO DINAMIC -->
        <div class="relative overflow-hidden bg-gradient-to-r from-indigo-950/60 via-slate-900/80 to-purple-950/40 border border-indigo-500/20 p-8 rounded-3xl shadow-2xl mb-10 backdrop-blur-xl group">
            <div class="absolute -right-10 -bottom-10 w-64 h-64 bg-indigo-500/10 rounded-full blur-3xl group-hover:bg-indigo-500/20 transition-all duration-700"></div>
            <div class="relative z-10 flex flex-col md:flex-row justify-between items-start md:items-center gap-6">
                <div>
                  
                    <h1 class="text-3xl md:text-4xl font-black text-white tracking-tight mb-2">Panou de Control Avansat</h1>
                    <p class="text-slate-400 text-sm max-w-xl">Monitorizare în timp real a parametrilor de conformitate, fluxului de audit și configurărilor comerciale.</p>
                </div>
                <div class="bg-slate-900/80 border border-slate-800 px-5 py-4 rounded-2xl flex items-center space-x-4 shadow-xl backdrop-blur-md">
                    <div class="p-3 bg-indigo-600/20 text-indigo-400 rounded-xl text-xl">
                        <i class="fa-regular fa-calendar-days"></i>
                    </div>
                    <div>
                        <span class="block text-[10px] uppercase tracking-wider text-slate-400 font-bold">Data Curentă</span>
                        <span class="text-sm font-extrabold text-white"><%= new Date().toLocaleDateString('ro-RO', { weekday: 'long', day: 'numeric', month: 'short', year: 'numeric' }) %></span>
                    </div>
                </div>
            </div>
        </div>

        <!-- KPI METRICS GRID -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-12">
            <!-- Stat 1 -->
            <div class="bg-slate-950/40 backdrop-blur-xl border border-slate-800/80 rounded-3xl p-6 hover:border-indigo-500/50 hover:bg-slate-900/40 transition-all duration-300 group shadow-xl">
                <div class="flex justify-between items-center mb-4">
                    <div class="p-3.5 bg-indigo-500/10 text-indigo-400 rounded-2xl group-hover:scale-110 group-hover:bg-indigo-600 group-hover:text-white transition-all duration-300 shadow-lg shadow-indigo-500/10">
                        <i class="fa-solid fa-users text-lg"></i>
                    </div>
                    <span class="text-[10px] font-extrabold uppercase px-2.5 py-1 bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 rounded-full">Bază Date</span>
                </div>
                <h3 class="text-slate-400 text-xs font-bold uppercase tracking-wider mb-1">Conturi Active</h3>
                <p class="text-3xl font-black text-white group-hover:text-indigo-400 transition-colors">3</p>
            </div>

            <!-- Stat 2 -->
            <div class="bg-slate-950/40 backdrop-blur-xl border border-slate-800/80 rounded-3xl p-6 hover:border-emerald-500/50 hover:bg-slate-900/40 transition-all duration-300 group shadow-xl">
                <div class="flex justify-between items-center mb-4">
                    <div class="p-3.5 bg-emerald-500/10 text-emerald-400 rounded-2xl group-hover:scale-110 group-hover:bg-emerald-600 group-hover:text-white transition-all duration-300 shadow-lg shadow-emerald-500/10">
                        <i class="fa-solid fa-landmark text-lg"></i>
                    </div>
                    <span class="text-[10px] font-extrabold uppercase px-2.5 py-1 bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 rounded-full">Normative</span>
                </div>
                <h3 class="text-slate-400 text-xs font-bold uppercase tracking-wider mb-1">Directive Europene</h3>
                <p class="text-3xl font-black text-white group-hover:text-emerald-400 transition-colors">4</p>
            </div>

            <!-- Stat 3 -->
            <div class="bg-slate-950/40 backdrop-blur-xl border border-slate-800/80 rounded-3xl p-6 hover:border-amber-500/50 hover:bg-slate-900/40 transition-all duration-300 group shadow-xl">
                <div class="flex justify-between items-center mb-4">
                    <div class="p-3.5 bg-amber-500/10 text-amber-400 rounded-2xl group-hover:scale-110 group-hover:bg-amber-600 group-hover:text-white transition-all duration-300 shadow-lg shadow-amber-500/10">
                        <i class="fa-solid fa-scale-balanced text-lg"></i>
                    </div>
                    <span class="text-[10px] font-extrabold uppercase px-2.5 py-1 bg-amber-500/10 text-amber-400 border border-amber-500/20 rounded-full">Audit Tehnic</span>
                </div>
                <h3 class="text-slate-400 text-xs font-bold uppercase tracking-wider mb-1">Reguli de Conformitate</h3>
                <p class="text-3xl font-black text-white group-hover:text-amber-400 transition-colors">3</p>
            </div>

            <!-- Stat 4 -->
            <div class="bg-slate-950/40 backdrop-blur-xl border border-slate-800/80 rounded-3xl p-6 hover:border-purple-500/50 hover:bg-slate-900/40 transition-all duration-300 group shadow-xl">
                <div class="flex justify-between items-center mb-4">
                    <div class="p-3.5 bg-purple-500/10 text-purple-400 rounded-2xl group-hover:scale-110 group-hover:bg-purple-600 group-hover:text-white transition-all duration-300 shadow-lg shadow-purple-500/10">
                        <i class="fa-solid fa-boxes-stacked text-lg"></i>
                    </div>
                    <span class="text-[10px] font-extrabold uppercase px-2.5 py-1 bg-purple-500/10 text-purple-400 border border-purple-500/20 rounded-full">Comercial</span>
                </div>
                <h3 class="text-slate-400 text-xs font-bold uppercase tracking-wider mb-1">Pachete Active</h3>
                <p class="text-3xl font-black text-white group-hover:text-purple-400 transition-colors">3</p>
            </div>
        </div>

        <!-- SECTIUNEA DE JURNAL RAPID / ACTIVITATE RECENTA (IN LOC DE DUPLICATE) -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
            
            <!-- Stare Sistem & Scurtaturi Rapide -->
            <div class="lg:col-span-1 bg-slate-950/50 border border-slate-800/80 rounded-3xl p-8 backdrop-blur-xl shadow-2xl flex flex-col justify-between">
                <div>
                    <h2 class="text-lg font-bold text-white mb-2 flex items-center space-x-2">
                        <i class="fa-solid fa-terminal text-indigo-400"></i>
                        <span>Acțiuni Rapide Admin</span>
                    </h2>
                    <p class="text-slate-400 text-xs mb-6">Comenzi frecvente pentru administrarea rapidă a platformei EUCheck.</p>
                    
                    <div class="space-y-3">
                        <a href="/Admin/Plans" class="flex items-center justify-between p-4 bg-slate-900/60 border border-slate-800 rounded-2xl hover:border-indigo-500/50 hover:bg-indigo-600/10 transition group">
                            <div class="flex items-center space-x-3">
                                <div class="w-9 h-9 bg-purple-500/10 text-purple-400 rounded-xl flex items-center justify-center group-hover:scale-110 transition">
                                    <i class="fa-solid fa-tags text-sm"></i>
                                </div>
                                <span class="text-sm font-bold text-slate-200">Modifică Tarife Pachete</span>
                            </div>
                            <i class="fa-solid fa-chevron-right text-xs text-slate-500 group-hover:text-indigo-400 group-hover:translate-x-1 transition"></i>
                        </a>

                        <a href="/Accounts" class="flex items-center justify-between p-4 bg-slate-900/60 border border-slate-800 rounded-2xl hover:border-indigo-500/50 hover:bg-indigo-600/10 transition group">
                            <div class="flex items-center space-x-3">
                                <div class="w-9 h-9 bg-indigo-500/10 text-indigo-400 rounded-xl flex items-center justify-center group-hover:scale-110 transition">
                                    <i class="fa-solid fa-user-shield text-sm"></i>
                                </div>
                                <span class="text-sm font-bold text-slate-200">Gestionează Conturi</span>
                            </div>
                            <i class="fa-solid fa-chevron-right text-xs text-slate-500 group-hover:text-indigo-400 group-hover:translate-x-1 transition"></i>
                        </a>

                        <a href="/ComplianceRules" class="flex items-center justify-between p-4 bg-slate-900/60 border border-slate-800 rounded-2xl hover:border-indigo-500/50 hover:bg-indigo-600/10 transition group">
                            <div class="flex items-center space-x-3">
                                <div class="w-9 h-9 bg-amber-500/10 text-amber-400 rounded-xl flex items-center justify-center group-hover:scale-110 transition">
                                    <i class="fa-solid fa-file-shield text-sm"></i>
                                </div>
                                <span class="text-sm font-bold text-slate-200">Setează Reguli Audit</span>
                            </div>
                            <i class="fa-solid fa-chevron-right text-xs text-slate-500 group-hover:text-indigo-400 group-hover:translate-x-1 transition"></i>
                        </a>
                    </div>
                </div>

                <div class="mt-8 pt-6 border-t border-slate-800/80 flex items-center justify-between text-xs text-slate-400">
                   
                    <span class="text-emerald-400 font-bold flex items-center"><i class="fa-solid fa-circle-check mr-1.5"></i> Conectat</span>
                </div>
            </div>

            <!-- Banner / Security Status Card -->
            <div class="lg:col-span-2 bg-gradient-to-br from-indigo-950/40 via-slate-950/60 to-purple-950/30 border border-indigo-500/20 rounded-3xl p-8 backdrop-blur-xl shadow-2xl flex flex-col justify-between relative overflow-hidden">
                <div class="absolute right-0 bottom-0 opacity-10 translate-x-10 translate-y-10 pointer-events-none">
                    <i class="fa-solid fa-shield-halved text-[240px] text-indigo-500"></i>
                </div>
                
                <div>
                    <div class="flex items-center justify-between mb-6">
                        <span class="px-3 py-1 bg-indigo-500/20 text-indigo-300 border border-indigo-500/30 rounded-full text-xs font-bold uppercase tracking-wider">Motor AI & Audit UE</span>
                    
                    </div>

                    <h2 class="text-2xl font-black text-white mb-3">Conformitate Directiva Mașini & Echipamente CE</h2>
                    
                </div>

                <div class="flex flex-wrap items-center gap-4">
                    <a href="/Admin/Logs" class="bg-indigo-600 hover:bg-indigo-500 text-white font-bold py-3 px-6 rounded-2xl text-sm transition shadow-lg shadow-indigo-600/30 flex items-center space-x-2">
                        <i class="fa-solid fa-clock-rotate-left"></i>
                        <span>Deschide Jurnalul de Audit</span>
                    </a>
                    <a href="/Standards" class="bg-slate-900 hover:bg-slate-800 text-slate-200 border border-slate-700 font-bold py-3 px-6 rounded-2xl text-sm transition flex items-center space-x-2">
                        <i class="fa-solid fa-book"></i>
                        <span>Vezi Directivele UE</span>
                    </a>
                </div>
            </div>

        </div>

    </main>

    <!-- FOOTER -->
    <footer class="max-w-7xl mx-auto px-6 py-10 mt-12 border-t border-slate-800/80 text-center text-xs text-slate-500">
        EUCheck Platform &bull; Securitate Avansată și Administrare Centralizată &copy; 2026
    </footer>

</body>
</html>