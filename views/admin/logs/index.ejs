<!DOCTYPE html>
<html lang="ro">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>EUCheck Admin - Jurnal de Audit</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="bg-[#090d16] text-slate-100 min-h-screen font-sans">

    <!-- NAVBAR SUPERIOR -->
    <header class="bg-[#0f172a]/70 backdrop-blur-xl border-b border-slate-800/80 sticky top-0 z-50 px-8 py-4 flex justify-between items-center">
        <div class="flex items-center space-x-3 cursor-pointer" onclick="window.location.href='/Admin'">
            <div class="bg-gradient-to-tr from-indigo-600 to-violet-500 text-white p-2.5 rounded-2xl shadow-lg shadow-indigo-500/20">
                <i class="fa-solid fa-shield-halved text-lg"></i>
            </div>
            <div>
                <span class="text-lg font-black tracking-wider text-white">EUCHECK <span class="text-indigo-400 font-light">CORE</span></span>
                <span class="block text-[10px] text-slate-400 font-semibold tracking-widest uppercase">Admin Security</span>
            </div>
        </div>

        <nav class="hidden lg:flex space-x-1 bg-slate-900/80 p-1.5 rounded-2xl border border-slate-800/80">
            <a href="/Admin" class="px-4 py-2 rounded-xl text-xs font-medium text-slate-400 hover:text-white transition-all">Dashboard</a>
            <a href="/Accounts" class="px-4 py-2 rounded-xl text-xs font-medium text-slate-400 hover:text-white transition-all">Conturi</a>
            <a href="/Standards" class="px-4 py-2 rounded-xl text-xs font-medium text-slate-400 hover:text-white transition-all">Directive UE</a>
            <a href="/ComplianceRules" class="px-4 py-2 rounded-xl text-xs font-medium text-slate-400 hover:text-white transition-all">Reguli</a>
            <a href="/Admin/Plans" class="px-4 py-2 rounded-xl text-xs font-medium text-slate-400 hover:text-white transition-all">Pachete</a>
            <a href="/Admin/Logs" class="px-4 py-2 rounded-xl text-xs font-bold bg-indigo-600 text-white shadow-lg shadow-indigo-600/30 transition-all">Jurnal</a>
        </nav>

        <div class="flex items-center space-x-3 bg-slate-900/80 border border-slate-800/80 px-4 py-2 rounded-2xl">
            <div class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse"></div>
            <span class="text-xs font-bold text-slate-300">admin.eucheck@gmail.com</span>
        </div>
    </header>

    <!-- CONTINUT PRINCIPAL -->
    <main class="max-w-7xl mx-auto px-6 py-10">
        
        <!-- HEADER PAGINA -->
        <div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-8 bg-gradient-to-r from-slate-900/90 via-slate-900/50 to-indigo-950/40 p-8 rounded-3xl border border-slate-800 shadow-2xl backdrop-blur-xl">
            <div>
                <span class="px-3 py-1 bg-indigo-500/10 border border-indigo-500/30 text-indigo-400 rounded-full text-[11px] font-bold uppercase tracking-wider mb-3 inline-block">
                    <i class="fa-solid fa-clock-rotate-left mr-1.5"></i> Securitate & Monitorizare
                </span>
                <h1 class="text-3xl font-black text-white tracking-tight mb-2">Jurnalul de Activitate & Audit</h1>
                <p class="text-slate-400 text-sm">Istoricul complet al modificărilor efectuate în panoul de control administrativ.</p>
            </div>
            <div class="mt-4 md:mt-0 flex items-center space-x-3">
                <a href="/Admin" class="bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs font-bold px-5 py-3 rounded-2xl transition border border-slate-700 flex items-center space-x-2">
                    <i class="fa-solid fa-arrow-left"></i>
                    <span>Înapoi la Dashboard</span>
                </a>
            </div>
        </div>

        <!-- LISTA DE JURNAL / TIMELINE -->
        <div class="bg-slate-950/60 border border-slate-800/80 rounded-3xl p-8 backdrop-blur-xl shadow-2xl">
            
            <div class="flex items-center justify-between mb-6 pb-4 border-b border-slate-800/80">
                <div class="flex items-center space-x-3">
                    <div class="p-2.5 bg-indigo-500/10 text-indigo-400 rounded-xl">
                        <i class="fa-solid fa-list-check"></i>
                    </div>
                    <h2 class="text-lg font-bold text-white">Înregistrări Active în Sistem</h2>
                </div>
                <span class="text-xs font-semibold px-3 py-1 bg-slate-900 border border-slate-800 text-slate-400 rounded-full">
                    Total: <%= adminLogs.length %> acțiuni
                </span>
            </div>

            <% if (adminLogs && adminLogs.length > 0) { %>
                <div class="space-y-4">
                    <% adminLogs.forEach(log => { %>
                        <div class="bg-slate-900/60 border border-slate-800/80 hover:border-indigo-500/40 p-5 rounded-2xl transition-all duration-300 flex flex-col md:flex-row justify-between items-start md:items-center gap-4 group">
                            <div class="flex items-start space-x-4">
                                <div class="p-3 bg-indigo-600/10 text-indigo-400 rounded-2xl mt-1 group-hover:scale-110 group-hover:bg-indigo-600 group-hover:text-white transition-all duration-300">
                                    <i class="fa-solid fa-pen-to-square text-base"></i>
                                </div>
                                <div>
                                    <div class="flex items-center space-x-2 mb-1">
                                        <span class="px-2.5 py-0.5 bg-indigo-500/10 text-indigo-300 border border-indigo-500/20 text-[10px] font-black uppercase tracking-wider rounded-md">
                                            <%= log.action %>
                                        </span>
                                        <span class="text-xs text-slate-400 font-medium"><%= log.user %></span>
                                    </div>
                                    <p class="text-sm font-bold text-slate-100"><%= log.details %></p>
                                </div>
                            </div>
                            <div class="flex items-center space-x-2 text-xs font-semibold text-slate-400 bg-slate-950/60 px-3.5 py-2 rounded-xl border border-slate-800/80">
                                <i class="fa-regular fa-clock text-indigo-400"></i>
                                <span><%= log.timestamp %></span>
                            </div>
                        </div>
                    <% }) %>
                </div>
            <% } else { %>
                <div class="text-center py-16 text-slate-500">
                    <i class="fa-solid fa-folder-open text-4xl mb-3 opacity-40"></i>
                    <p class="text-sm">Nu există nicio înregistrare în jurnalul de audit momentan.</p>
                </div>
            <% } %>

        </div>

    </main>

    <footer class="max-w-7xl mx-auto px-6 py-10 mt-12 border-t border-slate-800/80 text-center text-xs text-slate-500">
        EUCheck Platform &bull; Jurnal de Audit Securizat &copy; 2026
    </footer>

</body>
</html>