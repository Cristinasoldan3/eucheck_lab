<!DOCTYPE html>
<html lang="ro">
<head>
  <meta charset="UTF-8">
  <title>EUCheck Admin - Editare Pachet Comercial</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg-color: #0f172a;
      --card-bg: #1e293b;
      --text-main: #f8fafc;
      --text-muted: #94a3b8;
      --accent-blue: #3b82f6;
      --accent-purple: #8b5cf6;
      --border-color: rgba(255, 255, 255, 0.08);
    }
    * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Inter', sans-serif; }
    body { background-color: var(--bg-color); color: var(--text-main); min-height: 100vh; padding-bottom: 50px; }

    .navbar {
      background: rgba(15, 23, 42, 0.85);
      backdrop-filter: blur(12px);
      border-bottom: 1px solid var(--border-color);
      padding: 1rem 2.5rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .brand { font-size: 1.25rem; font-weight: 700; color: #fff; }
    .brand span { color: var(--accent-blue); }
    .nav-links { display: flex; gap: 8px; align-items: center; }
    .nav-links a {
      color: var(--text-muted); text-decoration: none; padding: 8px 14px;
      border-radius: 8px; font-weight: 500; font-size: 0.9rem; transition: all 0.2s ease;
    }
    .nav-links a:hover, .nav-links a.active { color: #fff; background: rgba(255, 255, 255, 0.06); }

    .container {
      max-width: 750px;
      margin: 40px auto;
      padding: 40px;
      background: var(--card-bg);
      border: 1px solid var(--border-color);
      border-radius: 16px;
      box-shadow: 0 10px 25px rgba(0,0,0,0.3);
    }

    h2 { font-size: 1.5rem; font-weight: 600; color: #fff; margin-bottom: 8px; }
    .subtitle { color: var(--text-muted); font-size: 0.95rem; margin-bottom: 30px; }

    .form-group { margin-bottom: 22px; }
    label { display: block; font-weight: 500; font-size: 0.85rem; margin-bottom: 8px; color: #cbd5e1; text-transform: uppercase; letter-spacing: 0.5px; }
    
    input[type="text"], input[type="number"] {
      width: 100%;
      padding: 12px 16px;
      background: rgba(15, 23, 42, 0.6);
      border: 1px solid var(--border-color);
      border-radius: 8px;
      color: #fff;
      font-size: 0.95rem;
      outline: none;
      transition: border-color 0.2s;
    }
    input[type="text"]:focus, input[type="number"]:focus { border-color: var(--accent-purple); }

    .checkbox-group {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-top: 15px;
      padding: 12px 16px;
      background: rgba(255, 255, 255, 0.02);
      border: 1px solid var(--border-color);
      border-radius: 8px;
      cursor: pointer;
    }
    .checkbox-group input[type="checkbox"] { width: 18px; height: 18px; accent-color: var(--accent-purple); cursor: pointer; }
    .checkbox-group label { margin-bottom: 0; cursor: pointer; color: #e2e8f0; text-transform: none; font-size: 0.95rem; font-weight: 500; }

    .actions-row {
      display: flex;
      gap: 15px;
      align-items: center;
      margin-top: 30px;
      padding-top: 20px;
      border-top: 1px solid var(--border-color);
    }

    .btn-submit {
      flex: 1;
      background: var(--accent-purple); color: white;
      padding: 12px; border: none; border-radius: 8px;
      font-size: 1rem; font-weight: 600; cursor: pointer;
      box-shadow: 0 4px 12px rgba(139, 92, 246, 0.3); transition: background 0.2s;
    }
    .btn-submit:hover { background: #7c3aed; }

    .btn-cancel {
      background: rgba(255, 255, 255, 0.05); color: var(--text-muted);
      padding: 12px 20px; border-radius: 8px; text-decoration: none;
      font-weight: 500; font-size: 0.9rem; border: 1px solid var(--border-color);
      text-align: center; transition: all 0.2s;
    }
    .btn-cancel:hover { background: rgba(255, 255, 255, 0.1); color: #fff; }

    .back-link {
      display: block; text-align: center; margin-top: 20px;
      color: var(--text-muted); text-decoration: none; font-size: 0.9rem;
    }
    .back-link:hover { color: #fff; }
  </style>
</head>
<body>

  <header class="navbar">
    <div class="brand">EUCheck <span>Admin</span></div>
    <nav class="nav-links">
      <a href="/Admin">Dashboard</a>
      <a href="/Accounts">Conturi</a>
      <a href="/Standards">Directive UE</a>
      <a href="/ComplianceRules">Reguli Conformitate</a>
      <a href="/Admin/Plans" class="active">Pachete</a>
      <a href="/Admin/Logs">Jurnal</a>
    </nav>
  </header>

  <div class="container">
    <h2>Editare Pachet Comercial</h2>
    <div class="subtitle">Modifică tarifele, numărul de tokeni și facilitățile ofertei pentru clienți.</div>

    <form action="/Admin/Plans/Edit/<%= plan.id %>" method="POST">
      
      <div class="form-group">
        <label>Nivel Pachet (Tier):</label>
        <input type="text" value="<%= plan.tier %>" disabled style="opacity: 0.7; cursor: not-allowed;" />
      </div>

      <div class="form-group">
        <label>Nume Afișat în Platformă:</label>
        <input type="text" name="display_name" value="<%= plan.display_name || plan.name || '' %>" required />
      </div>

      <div class="form-group">
        <label>Preț (EUR):</label>
        <input type="number" step="0.01" name="price_eur" value="<%= plan.price_eur || 0 %>" required />
      </div>

      <div class="form-group">
        <label>Tokeni Incluși în Pachet:</label>
        <input type="number" name="tokens_included" value="<%= plan.tokens_included || plan.tokens_allowed || 0 %>" required />
      </div>

      <div class="checkbox-group">
        <input type="checkbox" id="can_export_pdf" name="can_export_pdf" <%= plan.can_export_pdf ? 'checked' : '' %> />
        <label for="can_export_pdf">Include dreptul de export rapoarte oficiale PDF</label>
      </div>

      <div class="checkbox-group">
        <input type="checkbox" id="is_active" name="is_active" <%= plan.is_active !== false ? 'checked' : '' %> />
        <label for="is_active">Pachet activ și vizibil pentru achiziție în platformă</label>
      </div>

      <div class="actions-row">
        <button type="submit" class="btn-submit">Salvează Modificările</button>
        <a href="/Admin/Plans" class="btn-cancel">Anulează</a>
      </div>
    </form>

    <a href="/Admin/Plans" class="back-link">&larr; Înapoi la Lista de Pachete</a>
  </div>

</body>
</html>