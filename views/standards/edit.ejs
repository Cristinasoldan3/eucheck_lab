<!DOCTYPE html>
<html lang="ro">
<head>
  <meta charset="UTF-8">
  <title>EUCheck Admin - Editare Directivă</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg-color: #0f172a;
      --card-bg: #1e293b;
      --text-main: #f8fafc;
      --text-muted: #94a3b8;
      --accent-blue: #3b82f6;
      --accent-green: #10b981;
      --border-color: rgba(255, 255, 255, 0.08);
    }
    * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Inter', sans-serif; }
    body { background-color: var(--bg-color); color: var(--text-main); min-height: 100vh; padding-bottom: 50px; }

    .navbar {
      background: rgba(15, 23, 42, 0.85);
      backdrop-filter: blur(12px);
      border-bottom: 1px solid var(--border-color);
      padding: 1rem 2.5rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .brand { font-size: 1.25rem; font-weight: 700; color: #fff; }
    .brand span { color: var(--accent-blue); }
    .nav-links { display: flex; gap: 8px; align-items: center; }
    .nav-links a {
      color: var(--text-muted); text-decoration: none; padding: 8px 14px;
      border-radius: 8px; font-weight: 500; font-size: 0.9rem; transition: all 0.2s ease;
    }
    .nav-links a:hover, .nav-links a.active { color: #fff; background: rgba(255, 255, 255, 0.06); }

    .container {
      max-width: 750px;
      margin: 40px auto;
      padding: 40px;
      background: var(--card-bg);
      border: 1px solid var(--border-color);
      border-radius: 16px;
      box-shadow: 0 10px 25px rgba(0,0,0,0.3);
    }

    h2 { font-size: 1.5rem; font-weight: 600; color: #fff; margin-bottom: 8px; }
    .subtitle { color: var(--text-muted); font-size: 0.95rem; margin-bottom: 30px; }

    .form-group { margin-bottom: 22px; }
    label { display: block; font-weight: 500; font-size: 0.85rem; margin-bottom: 8px; color: #cbd5e1; text-transform: uppercase; letter-spacing: 0.5px; }
    
    input[type="text"], input[type="url"], select {
      width: 100%;
      padding: 12px 16px;
      background: rgba(15, 23, 42, 0.6);
      border: 1px solid var(--border-color);
      border-radius: 8px;
      color: #fff;
      font-size: 0.95rem;
      outline: none;
      transition: border-color 0.2s;
    }
    input[type="text"]:focus, input[type="url"]:focus, select:focus { border-color: var(--accent-blue); }
    select option { background: #1e293b; color: #fff; }

    .checkbox-group {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-top: 15px;
      padding: 12px 16px;
      background: rgba(255, 255, 255, 0.02);
      border: 1px solid var(--border-color);
      border-radius: 8px;
      cursor: pointer;
    }
    .checkbox-group input[type="checkbox"] { width: 18px; height: 18px; accent-color: var(--accent-blue); cursor: pointer; }
    .checkbox-group label { margin-bottom: 0; cursor: pointer; color: #e2e8f0; text-transform: none; font-size: 0.95rem; font-weight: 500; }

    .actions-row {
      display: flex;
      gap: 15px;
      align-items: center;
      margin-top: 30px;
      padding-top: 20px;
      border-top: 1px solid var(--border-color);
    }

    .btn-submit {
      flex: 1;
      background: var(--accent-blue); color: white;
      padding: 12px; border: none; border-radius: 8px;
      font-size: 1rem; font-weight: 600; cursor: pointer;
      transition: background 0.2s;
      box-shadow: 0 4px 12px rgba(59, 130, 246, 0.3);
    }
    .btn-submit:hover { background: #2563eb; }

    .btn-cancel {
      background: rgba(255, 255, 255, 0.05); color: var(--text-muted);
      padding: 12px 20px; border-radius: 8px; text-decoration: none;
      font-weight: 500; font-size: 0.9rem; border: 1px solid var(--border-color);
      text-align: center; transition: all 0.2s;
    }
    .btn-cancel:hover { background: rgba(255, 255, 255, 0.1); color: #fff; }

    .back-link {
      display: block; text-align: center; margin-top: 20px;
      color: var(--text-muted); text-decoration: none; font-size: 0.9rem;
    }
    .back-link:hover { color: #fff; }
  </style>
</head>
<body>

  <header class="navbar">
    <div class="brand">EUCheck <span>Admin</span></div>
    <nav class="nav-links">
      <a href="/Admin">Dashboard</a>
      <a href="/Accounts">Conturi</a>
      <a href="/Standards" class="active">Directive UE</a>
      <a href="/ComplianceRules">Reguli Conformitate</a>
      <a href="/Admin/Plans">Pachete</a>
      <a href="/Admin/Logs">Jurnal</a>
    </nav>
  </header>

  <div class="container">
    <h2>Modificare Directivă & Standard</h2>
    <div class="subtitle">Actualizează parametrii normativului european.</div>

    <form action="/Standards/Edit/<%= standard.id %>" method="POST">
      
      <div class="form-group">
        <label>Cod Directivă / Standard:</label>
        <input type="text" name="code" value="<%= standard.code || standard.directive_code || '' %>" required />
      </div>

      <div class="form-group">
        <label>Titlu / Denumire Oficială:</label>
        <input type="text" name="title" value="<%= standard.title || standard.name || '' %>" required />
      </div>

      <div class="form-group">
        <label>Categorie Industrială:</label>
        <select name="category">
          <option value="Directiva Mașini Industriale (2006/42/CE)" <%= standard.category === 'Directiva Mașini Industriale (2006/42/CE)' ? 'selected' : '' %>>Directiva Mașini Industriale (2006/42/CE)</option>
          <option value="Directiva Joasă Tensiune (2014/35/UE)" <%= standard.category === 'Directiva Joasă Tensiune (2014/35/UE)' ? 'selected' : '' %>>Directiva Joasă Tensiune (2014/35/UE)</option>
          <option value="Directiva RoHS & Echipamente Electrice" <%= standard.category === 'Directiva RoHS & Echipamente Electrice' ? 'selected' : '' %>>Directiva RoHS & Echipamente Electrice</option>
        </select>
      </div>

      <div class="form-group">
        <label>URL Text Oficial (EUR-Lex):</label>
        <input type="text" name="official_url" value="<%= standard.official_url || '' %>" placeholder="https://eur-lex.europa.eu/..." />
      </div>

      <div class="form-group">
        <label>Versiune / Revizie:</label>
        <input type="text" name="version" value="<%= standard.version || '1' %>" />
      </div>

      <div class="checkbox-group">
        <input type="checkbox" id="is_active" name="is_active" <%= standard.is_active !== false ? 'checked' : '' %> />
        <label for="is_active">Directivă activă în sistemul de verificare și audit</label>
      </div>

      <div class="actions-row">
        <button type="submit" class="btn-submit">Salvează Modificările</button>
        <a href="/Standards" class="btn-cancel">Anulează</a>
      </div>
    </form>

    <a href="/Standards" class="back-link">&larr; Înapoi la Lista de Directive</a>
  </div>

</body>
</html>